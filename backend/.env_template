# Model Provider Configuration
# Select which model provider to use (zhipu or volcengine)
MODEL_PROVIDER=zhipu

# OpenAI Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1

# Model Configuration
MODEL_NAME=glm-4.7-flash
MODEL_TEMPERATURE=0.3
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=3

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging Configuration
LOG_LEVEL=info

# WeatherAPI Configuration
# Get your API key from https://www.weatherapi.com
WEATHER_API_KEY=your_weatherapi_key_here

# Search API Configuration
# Get your API keys from respective providers
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Search Provider Configuration
# Select which search provider to use (tavily, serpapi, or serper)
SEARCH_PROVIDER=tavily
